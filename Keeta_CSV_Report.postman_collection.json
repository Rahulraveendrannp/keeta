          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startDate\": \"2025-12-01\",\n  \"endDate\": \"2025-12-07\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/admin/generate-report",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "admin",
            "generate-report"
          ]
        },
        "description": "Example: Generate report for first week of December"
      },
      "response": []
    },
